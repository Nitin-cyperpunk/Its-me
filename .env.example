# Copy to .env.local and set your real values.
# (The canonical site URL is fixed in src/lib/site.ts — no env var needed.)

# Footer visitor counter (server-only — never prefix these with NEXT_PUBLIC_).
# Upstash Redis REST credentials (Vercel's Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN instead; both work).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Signs the visitor cookie. At least 32 characters, e.g. `openssl rand -base64 32`.
VISITOR_COOKIE_SECRET=

# Footer contact form — EmailJS (https://www.emailjs.com). These are public by
# design (the browser sends the email); never put the EmailJS *private* key here.
# Template variables: {{name}} {{email}} {{title}} {{message}} {{time}},
# with the template's Reply-To set to {{reply_to}}.


# GitHub section (optional, server-only). The graph works without it; a token
# (fine-grained, no permissions needed) only raises the GitHub API rate limit
# used for the repo count / top language.

# Portfolio content database — Neon Postgres (server-only; never NEXT_PUBLIC_).
# Get both from Neon → project → Connect, or `pnpm dlx neon@latest connection-string`.
# DATABASE_URL: the POOLED string (host contains "-pooler") — used by the site.
# DATABASE_URL_UNPOOLED: the direct string — used only by `pnpm db:migrate`.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Any long random string; protects POST /api/revalidate, which refreshes cached
# portfolio content right after a database edit (otherwise it refreshes hourly).
REVALIDATE_SECRET=
