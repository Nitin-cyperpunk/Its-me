# Copy to .env.local and set your real values.
# (The canonical site URL is fixed in src/lib/site.ts — no env var needed.)

# Footer visitor counter (server-only — never prefix these with NEXT_PUBLIC_).
# Upstash Redis REST credentials (Vercel's Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN instead; both work).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Signs the visitor cookie. At least 32 characters, e.g. `openssl rand -base64 32`.
VISITOR_COOKIE_SECRET=
